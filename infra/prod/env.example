# Production configuration. Copy to .env.prod at the repository root, fill
# every empty value and keep the file out of git (`chmod 600 .env.prod`).
# Random secrets: `openssl rand -hex 32` (session secret: 32+ characters).

# ── Addresses ────────────────────────────────────────────────────────────────
# DNS A/AAAA records of both names point at the server.
SNOSKA_DOMAIN=snoska.example.ru
SNOSKA_AUTH_DOMAIN=auth.snoska.example.ru
SNOSKA_WEB_URL=https://snoska.example.ru
SNOSKA_KEYCLOAK_URL=https://auth.snoska.example.ru
# Keycloak under a path of the product's name instead of its own name: KEYCLOAK_PATH=/auth
# and SNOSKA_KEYCLOAK_URL=https://snoska.example.ru/auth (docs/deploy.md, «Одно имя»).
KEYCLOAK_PATH=
# Let's Encrypt account (expiry notices).
SNOSKA_ACME_EMAIL=
# Published ports of Caddy (the only published ones).
SNOSKA_HTTP_PORT=80
SNOSKA_HTTPS_PORT=443
SNOSKA_BIND=0.0.0.0

# ── Secrets ──────────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER_PASSWORD=
SNOSKA_DB_OWNER_PASSWORD=
SNOSKA_DB_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=
SNOSKA_REDIS_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
SNOSKA_WEB_CLIENT_SECRET=
SNOSKA_DIRECTORY_CLIENT_SECRET=
SNOSKA_DEMO_CLIENT_SECRET=
SNOSKA_SESSION_SECRET=
# Seals webhook signing secrets; changing it makes them unreadable.
SNOSKA_SECRETS_KEY=

# ── Mail (invitations, password reset, notices) ──────────────────────────────
SNOSKA_SMTP_HOST=
SNOSKA_SMTP_PORT=587
SNOSKA_SMTP_USERNAME=
SNOSKA_SMTP_PASSWORD=
SNOSKA_SMTP_START_TLS=true
SNOSKA_SMTP_AUTH=true
# The address the mail server lets the account send from.
SNOSKA_SMTP_FROM=
SNOSKA_SMTP_SENDER=Сноска <no-reply@snoska.example.ru>

# ── Language model and embeddings (external API only) ────────────────────────
SNOSKA_AI_PROVIDER=openai_compatible
SNOSKA_LLM_BASE_URL=https://openrouter.ai/api/v1
SNOSKA_LLM_API_KEY=
SNOSKA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
SNOSKA_LLM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
SNOSKA_LLM_EXTRA_BODY={"reasoning": {"enabled": false}}
# Free tier: 50 requests a day; keep a margin. 0: no limit (a paid plan).
SNOSKA_LLM_REQUESTS_PER_MINUTE=18
SNOSKA_LLM_REQUESTS_PER_DAY=45
SNOSKA_EMBEDDING_MODEL=baai/bge-m3
SNOSKA_EMBEDDING_DIMENSIONS=1024

# ── Payments ─────────────────────────────────────────────────────────────────
# `test` takes no money. A real provider needs its own adapter and contract.
SNOSKA_PAYMENTS_PROVIDER=test
SNOSKA_PAYMENTS_TEST_SECRET=

# ── Sizing ───────────────────────────────────────────────────────────────────
SNOSKA_API_WORKERS=2
SNOSKA_WORKER_THREADS=4
# Connections of each backend process: pool plus overflow (defaults 5 and 5).
SNOSKA_DB_POOL_SIZE=
SNOSKA_DB_MAX_OVERFLOW=
# Keycloak's JVM heap, e.g. `-Xms64m -Xmx192m` on a small host; empty keeps Keycloak's
# default (70% of the container's memory). Extra JVM flags and the database pool cap.
KEYCLOAK_HEAP_OPTIONS=
KEYCLOAK_JAVA_OPTIONS=
KEYCLOAK_DB_POOL_MAX_SIZE=100

# ── Backups (UTC hour, days kept, host directory) ────────────────────────────
SNOSKA_BACKUP_HOUR=2
SNOSKA_BACKUP_KEEP_DAYS=14
SNOSKA_BACKUP_DIR=./backups

# ── Demo stand only ──────────────────────────────────────────────────────────
# true + `--profile demo`: one-click sign-in by role and the nightly reset.
SNOSKA_DEMO_MODE=false
SNOSKA_DEMO_RESET_HOUR=3

SNOSKA_LOG_LEVEL=INFO
