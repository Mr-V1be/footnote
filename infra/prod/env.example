# Production configuration. Copy to .env.prod at the repository root and keep the
# file out of git (`chmod 600 .env.prod`). Settings marked `# @secret` take random
# values: `openssl rand -hex 32`. Fill in the installation's addresses, mail and
# model key; the sizing and Keycloak options may stay empty (their defaults).

# ── Addresses ────────────────────────────────────────────────────────────────
# DNS A/AAAA records of both names point at the server.
FOOTNOTE_DOMAIN=footnote.example.ru
FOOTNOTE_AUTH_DOMAIN=auth.footnote.example.ru
FOOTNOTE_WEB_URL=https://footnote.example.ru
FOOTNOTE_KEYCLOAK_URL=https://auth.footnote.example.ru
# Keycloak under a path of the product's name instead of its own name: KEYCLOAK_PATH=/auth
# and FOOTNOTE_KEYCLOAK_URL=https://footnote.example.ru/auth (docs/deploy.md, «Одно имя»).
KEYCLOAK_PATH=
# Let's Encrypt account (expiry notices).
FOOTNOTE_ACME_EMAIL=
# Published ports of Caddy (the only published ones).
FOOTNOTE_HTTP_PORT=80
FOOTNOTE_HTTPS_PORT=443
FOOTNOTE_BIND=0.0.0.0

# ── Secrets ──────────────────────────────────────────────────────────────────
# @secret
POSTGRES_SUPERUSER_PASSWORD=
# @secret
FOOTNOTE_DB_OWNER_PASSWORD=
# @secret
FOOTNOTE_DB_APP_PASSWORD=
# @secret
KEYCLOAK_DB_PASSWORD=
# @secret
FOOTNOTE_REDIS_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
# @secret
KEYCLOAK_ADMIN_PASSWORD=
# @secret
FOOTNOTE_WEB_CLIENT_SECRET=
# @secret
FOOTNOTE_DIRECTORY_CLIENT_SECRET=
# @secret
FOOTNOTE_DEMO_CLIENT_SECRET=
# @secret 32
FOOTNOTE_SESSION_SECRET=
# Seals webhook signing secrets; changing it makes them unreadable.
# @secret
FOOTNOTE_SECRETS_KEY=

# ── Mail (invitations, password reset, notices) ──────────────────────────────
FOOTNOTE_SMTP_HOST=
FOOTNOTE_SMTP_PORT=587
FOOTNOTE_SMTP_USERNAME=
FOOTNOTE_SMTP_PASSWORD=
FOOTNOTE_SMTP_START_TLS=true
FOOTNOTE_SMTP_AUTH=true
# The address the mail server lets the account send from.
FOOTNOTE_SMTP_FROM=
FOOTNOTE_SMTP_SENDER=Footnote <no-reply@footnote.example.ru>

# ── Language model and embeddings (external API only) ────────────────────────
FOOTNOTE_AI_PROVIDER=openai_compatible
FOOTNOTE_LLM_BASE_URL=https://openrouter.ai/api/v1
FOOTNOTE_LLM_API_KEY=
FOOTNOTE_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
FOOTNOTE_LLM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
FOOTNOTE_LLM_EXTRA_BODY={"reasoning": {"enabled": false}}
# Free tier: 50 requests a day; keep a margin. 0: no limit (a paid plan).
FOOTNOTE_LLM_REQUESTS_PER_MINUTE=18
FOOTNOTE_LLM_REQUESTS_PER_DAY=45
FOOTNOTE_EMBEDDING_MODEL=baai/bge-m3
FOOTNOTE_EMBEDDING_DIMENSIONS=1024

# ── Payments ─────────────────────────────────────────────────────────────────
# `test` takes no money. A real provider needs its own adapter and contract.
FOOTNOTE_PAYMENTS_PROVIDER=test
# @secret
FOOTNOTE_PAYMENTS_TEST_SECRET=

# ── Sizing ───────────────────────────────────────────────────────────────────
FOOTNOTE_API_WORKERS=2
FOOTNOTE_WORKER_THREADS=4
# Connections of each backend process: pool plus overflow (defaults 5 and 5).
FOOTNOTE_DB_POOL_SIZE=
FOOTNOTE_DB_MAX_OVERFLOW=
# Keycloak's JVM heap, e.g. `-Xms64m -Xmx192m` on a small host; empty keeps Keycloak's
# default (70% of the container's memory). Extra JVM flags and the database pool cap.
KEYCLOAK_HEAP_OPTIONS=
KEYCLOAK_JAVA_OPTIONS=
KEYCLOAK_DB_POOL_MAX_SIZE=100

# ── Backups (UTC hour, days kept, host directory) ────────────────────────────
FOOTNOTE_BACKUP_HOUR=2
FOOTNOTE_BACKUP_KEEP_DAYS=14
FOOTNOTE_BACKUP_DIR=./backups

# ── Demo stand only ──────────────────────────────────────────────────────────
# true + `--profile demo`: one-click sign-in by role and the nightly reset.
FOOTNOTE_DEMO_MODE=false
FOOTNOTE_DEMO_RESET_HOUR=3

FOOTNOTE_LOG_LEVEL=INFO
