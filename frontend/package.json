{
  "name": "snoska-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 46300 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --port 46300 --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "lint:styles": "stylelint \"src/**/*.css\" \"../infra/keycloak/themes/*/login/resources/css/login.css\"",
    "format": "prettier --write . \"../infra/keycloak/themes/*/login/resources/{css,js}/*.{css,js}\"",
    "format:check": "prettier --check . \"../infra/keycloak/themes/*/login/resources/{css,js}/*.{css,js}\"",
    "api:generate": "node scripts/generate-api-types.mjs",
    "api:check": "node scripts/generate-api-types.mjs --check",
    "screenshots": "node e2e/screenshots.mjs",
    "test": "vitest run",
    "theme:sync": "node scripts/sync-theme-assets.mjs",
    "theme:check": "node scripts/sync-theme-assets.mjs --check"
  },
  "dependencies": {
    "@tabler/icons-react": "3.48.0",
    "@tanstack/react-query": "5.104.1",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.17.0",
    "openid-client": "6.8.8",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.3.8",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
