{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "function-disallowed-list": ["rgb", "rgba", "hsl", "hsla"],
    "selector-class-pattern": "^[a-z][a-zA-Z0-9]*$",
    "custom-property-pattern": "^[a-z][a-z0-9-]*$",
    "declaration-property-value-disallowed-list": {
      "/^(margin|padding|gap|row-gap|column-gap|inset|top|right|bottom|left)/": [
        "/^-?\\d+(\\.\\d+)?px/"
      ],
      "font-size": ["/^\\d+(\\.\\d+)?(px|rem)$/"],
      "border-radius": ["/^\\d+(\\.\\d+)?(px|rem)$/"],
      "z-index": ["/^\\d+$/"]
    },
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": ["global"]
      }
    ],
    "property-no-vendor-prefix": [
      true,
      {
        "ignoreProperties": ["backdrop-filter", "text-size-adjust", "box-orient", "line-clamp"]
      }
    ],
    "import-notation": "string",
    "custom-property-empty-line-before": null,
    "value-no-vendor-prefix": [
      true,
      {
        "ignoreValues": ["box"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/shared/tokens/**/*.css"],
      "rules": {
        "color-no-hex": null,
        "function-disallowed-list": null,
        "declaration-property-value-disallowed-list": null
      }
    },
    {
      "files": ["../infra/keycloak/themes/**/*.css"],
      "rules": {
        "selector-class-pattern": "^[a-z][a-z0-9-]*(__[a-z0-9-]+)?(--[a-z0-9-]+)?$"
      }
    }
  ]
}
