# Local configuration for Snoska. Copy to `.env` and fill the empty values
# (`make env` generates random secrets). Never commit `.env`.

# ── Ports (the project owns the 46300–46399 range) ───────────────────────────
SNOSKA_WEB_PORT=46300
SNOSKA_API_PORT=46301
SNOSKA_API_WORKERS=1
SNOSKA_DB_PORT=46310
SNOSKA_REDIS_PORT=46311
SNOSKA_KEYCLOAK_PORT=46320
SNOSKA_MAILPIT_UI_PORT=46330
SNOSKA_MAILPIT_SMTP_PORT=46331
SNOSKA_MINIO_PORT=46340
SNOSKA_MINIO_CONSOLE_PORT=46341

# ── Public URLs ──────────────────────────────────────────────────────────────
SNOSKA_WEB_URL=http://localhost:46300
SNOSKA_API_URL=http://127.0.0.1:46301

# ── PostgreSQL ───────────────────────────────────────────────────────────────
SNOSKA_DB_HOST=127.0.0.1
SNOSKA_DB_NAME=snoska
# Superuser of the local container; used only by the init scripts.
POSTGRES_SUPERUSER_PASSWORD=
# Schema owner: runs migrations.
SNOSKA_DB_OWNER_PASSWORD=
# Runtime role: subject to row-level security.
SNOSKA_DB_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# ── Redis (job queue broker, web sessions) ───────────────────────────────────
SNOSKA_REDIS_HOST=127.0.0.1
SNOSKA_REDIS_PASSWORD=

# ── Keycloak (OIDC) ──────────────────────────────────────────────────────────
SNOSKA_KEYCLOAK_URL=http://localhost:46320
SNOSKA_KEYCLOAK_REALM=snoska
# Bootstrap administrator of the Keycloak master realm.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
# Confidential client used by the web app (authorization code + PKCE).
SNOSKA_WEB_CLIENT_SECRET=
# Service account used by the API to read and provision organizations.
SNOSKA_DIRECTORY_CLIENT_SECRET=
# Encrypts the web session cookie (32+ random characters).
SNOSKA_SESSION_SECRET=

# ── Demo stand ───────────────────────────────────────────────────────────────
# One-click sign-in by role (owner, lawyer, observer, platform operator), demo
# accounts that keep their roles and `snoska demo reset` / `nightly`. The code
# default is false; this local stand is a demo. Never enable it in production.
SNOSKA_DEMO_MODE=true
# Secret of the Keycloak client the web server signs demo visitors in with.
SNOSKA_DEMO_CLIENT_SECRET=
# Local hour of the nightly return to the seed (`snoska demo nightly`).
SNOSKA_DEMO_RESET_HOUR=3

# ── Integrations ─────────────────────────────────────────────────────────────
# Seals stored secrets (webhook signing keys). Changing it makes existing
# webhook secrets unreadable: rotate them afterwards.
SNOSKA_SECRETS_KEY=
# Lets webhooks go to private addresses over http (the demo stand's own
# receiver); keep `false` on any shared deployment.
SNOSKA_WEBHOOKS_ALLOW_PRIVATE=true
# The demo stand's own webhook receiver (/api/v1/demo/webhooks/...).
SNOSKA_DEMO_RECEIVER=true

# ── Payments ─────────────────────────────────────────────────────────────────
# The stand pays through a test provider: no account, no money, no card data.
SNOSKA_PAYMENTS_PROVIDER=test
# Signs the test provider's checkout links and webhooks.
SNOSKA_PAYMENTS_TEST_SECRET=

# ── Language model and embeddings ────────────────────────────────────────────
# Models run only behind an external API; nothing runs on this machine.
# `none` (default): model checks report "model not connected".
# `openai_compatible`: any server with the OpenAI chat completions and
# embeddings API.
SNOSKA_AI_PROVIDER=none
SNOSKA_LLM_BASE_URL=
SNOSKA_LLM_API_KEY=
SNOSKA_LLM_MODEL=
# Embeddings: empty URL and key reuse the language model's.
SNOSKA_EMBEDDING_BASE_URL=
SNOSKA_EMBEDDING_API_KEY=
SNOSKA_EMBEDDING_MODEL=
# Vector size the embedding model returns. After changing the model or the
# size, run `make index` to embed the corpus in the new space.
SNOSKA_EMBEDDING_DIMENSIONS=
# Free tiers allow a pace and a number of requests a day (0: no limit); the
# installation keeps to them across processes and checks wait for the next
# day when today's are spent.
SNOSKA_LLM_REQUESTS_PER_MINUTE=0
SNOSKA_LLM_REQUESTS_PER_DAY=0
# Models that answer when the first one is busy, comma-separated (free only,
# unless the owner decides otherwise).
SNOSKA_LLM_FALLBACK_MODELS=
# Extra JSON fields of every chat request, e.g. {"reasoning": {"effort": "low"}}.
SNOSKA_LLM_EXTRA_BODY=
# Days a model answer is reused for the same request.
SNOSKA_LLM_CACHE_DAYS=30

# ── Checks ───────────────────────────────────────────────────────────────────
# Legal requirements of a document asked in one model request (free tiers
# allow few requests a day; a document's checks share one or two).
SNOSKA_CHECKS_CHECKS_PER_REQUEST=12

# ── Storage ──────────────────────────────────────────────────────────────────
# `s3`: the MinIO bucket of the compose stack (any S3-compatible store works);
# `local`: a directory, relative paths resolve against the repository root.
SNOSKA_STORAGE_BACKEND=s3
SNOSKA_STORAGE_ROOT=var/blobs
SNOSKA_S3_ENDPOINT=127.0.0.1:46340
SNOSKA_S3_BUCKET=snoska
# Credentials of the MinIO root user (also the API's access key on the stand).
SNOSKA_S3_ACCESS_KEY=
SNOSKA_S3_SECRET_KEY=

# ── Notifications and periodic work ──────────────────────────────────────────
# Mail goes to Mailpit on the stand (its web UI on SNOSKA_MAILPIT_UI_PORT).
SNOSKA_SMTP_HOST=127.0.0.1
SNOSKA_SMTP_PORT=46331
# Hours between checks of the official portal for new redactions of the acts.
SNOSKA_CORPUS_WATCH_INTERVAL_HOURS=168

# ── Observability ────────────────────────────────────────────────────────────
SNOSKA_LOG_LEVEL=INFO
# `none`, `console` or `otlp`.
SNOSKA_TRACING_EXPORTER=none
SNOSKA_OTLP_ENDPOINT=
