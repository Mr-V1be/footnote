# Local configuration for Snoska. Copy to `.env` and fill the empty values
# (`make env` generates random secrets). Never commit `.env`.

# ── Ports (the project owns the 46300–46399 range) ───────────────────────────
SNOSKA_WEB_PORT=46300
SNOSKA_API_PORT=46301
SNOSKA_DB_PORT=46310
SNOSKA_REDIS_PORT=46311
SNOSKA_KEYCLOAK_PORT=46320
SNOSKA_MAILPIT_UI_PORT=46330
SNOSKA_MAILPIT_SMTP_PORT=46331

# ── Public URLs ──────────────────────────────────────────────────────────────
SNOSKA_WEB_URL=http://localhost:46300
SNOSKA_API_URL=http://127.0.0.1:46301

# ── PostgreSQL ───────────────────────────────────────────────────────────────
SNOSKA_DB_HOST=127.0.0.1
SNOSKA_DB_NAME=snoska
# Superuser of the local container; used only by the init scripts.
POSTGRES_SUPERUSER_PASSWORD=
# Schema owner: runs migrations.
SNOSKA_DB_OWNER_PASSWORD=
# Runtime role: subject to row-level security.
SNOSKA_DB_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# ── Redis (job queue broker, web sessions) ───────────────────────────────────
SNOSKA_REDIS_HOST=127.0.0.1
SNOSKA_REDIS_PASSWORD=

# ── Keycloak (OIDC) ──────────────────────────────────────────────────────────
SNOSKA_KEYCLOAK_URL=http://localhost:46320
SNOSKA_KEYCLOAK_REALM=snoska
# Bootstrap administrator of the Keycloak master realm.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
# Confidential client used by the web app (authorization code + PKCE).
SNOSKA_WEB_CLIENT_SECRET=
# Service account used by the API to read and provision organizations.
SNOSKA_DIRECTORY_CLIENT_SECRET=
# Encrypts the web session cookie (32+ random characters).
SNOSKA_SESSION_SECRET=

# ── Language model and embeddings ────────────────────────────────────────────
# Models run only behind an external API; nothing runs on this machine.
# `none` (default): model checks report "model not connected".
# `openai_compatible`: any server with the OpenAI chat completions and
# embeddings API.
SNOSKA_AI_PROVIDER=none
SNOSKA_LLM_BASE_URL=
SNOSKA_LLM_API_KEY=
SNOSKA_LLM_MODEL=
# Embeddings: empty URL and key reuse the language model's.
SNOSKA_EMBEDDING_BASE_URL=
SNOSKA_EMBEDDING_API_KEY=
SNOSKA_EMBEDDING_MODEL=
# Vector size the embedding model returns. After changing the model or the
# size, run `make index` to embed the corpus in the new space.
SNOSKA_EMBEDDING_DIMENSIONS=

# ── Checks ───────────────────────────────────────────────────────────────────
# Model checks running at once (also the model server's parallel slots).
SNOSKA_CHECKS_MODEL_CONCURRENCY=2

# ── Storage ──────────────────────────────────────────────────────────────────
# Original uploads; relative paths resolve against the repository root.
SNOSKA_STORAGE_ROOT=var/blobs

# ── Observability ────────────────────────────────────────────────────────────
SNOSKA_LOG_LEVEL=INFO
# `none`, `console` or `otlp`.
SNOSKA_TRACING_EXPORTER=none
SNOSKA_OTLP_ENDPOINT=
